# Auto-scaffolded nginx site for {{server_name}}.
# Install as /etc/nginx/sites-available/{{name}}, symlink into sites-enabled, then
# `nginx -t` BEFORE `systemctl reload nginx` — a config error takes the whole server down.
#
# The upstream is 127.0.0.1: the app itself must stay bound to loopback so nginx is the only
# way in. If the app listens on 0.0.0.0 this proxy is decoration, not a boundary.

server {
    listen 80;
    listen [::]:80;
    server_name {{server_name}};

    # Leave this reachable so certbot's HTTP-01 challenge can renew the certificate.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{server_name}};

    ssl_certificate     /etc/letsencrypt/live/{{server_name}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{server_name}}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Do not advertise the exact nginx build to every scanner that connects.
    server_tokens off;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:{{port}};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
