# Auto-scaffolded Dependabot config (.github/dependabot.yml).
# The github-actions ecosystem is listed deliberately: a pinned-by-tag action is a supply-chain
# dependency like any other, and it is the one most projects forget to update.
version: 2
updates:
  - package-ecosystem: "{{ecosystem}}"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    labels:
      - "dependencies"

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    labels:
      - "dependencies"
      - "ci"
