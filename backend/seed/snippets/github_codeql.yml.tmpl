# Auto-scaffolded CodeQL code-scanning workflow.
# Static analysis on every push/PR plus a weekly scheduled run — the schedule matters because
# new queries ship after your last commit, and a rule written today can flag code from last year.
name: CodeQL

permissions:
  contents: read

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  schedule:
    - cron: "27 4 * * 1"

jobs:
  analyze:
    name: Analyze
    runs-on: ubuntu-latest
    permissions:
      contents: read
      # Required so CodeQL can upload results to the Security tab.
      security-events: write
    strategy:
      fail-fast: false
      matrix:
        language: [ {{language}} ]
    steps:
      - uses: actions/checkout@v4
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: ${{ matrix.language }}
          queries: security-and-quality
      - name: Autobuild
        uses: github/codeql-action/autobuild@v3
      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3
