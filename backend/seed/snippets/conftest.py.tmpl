"""Auto-scaffolded pytest conftest for this repository.

conftest.py is imported by pytest before collection, which makes it the right (and only
reliable) place to put the sys.path fix-up and the session-wide fixtures. Keep it free of
side effects beyond that: anything expensive here is paid by every test run.
"""
from __future__ import annotations

import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


@pytest.fixture(scope="session")
def repo_root() -> Path:
    """The repository root, so a test never hard-codes an absolute path."""
    return ROOT


@pytest.fixture()
def workspace(tmp_path: Path) -> Path:
    """An isolated, throwaway workspace. Tests must write HERE, never into the repo."""
    return tmp_path
