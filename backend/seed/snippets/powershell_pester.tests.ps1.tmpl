# Auto-scaffolded Pester v5 test file for {{target}}.
# Run it with: Invoke-Pester -Path ./{{name}}.Tests.ps1
#
# The first It is a real assertion, not a placeholder: it parses the script with PowerShell's
# own parser, which catches the syntax errors that only surface at run time otherwise.

#Requires -Modules Pester

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

BeforeAll {
    $script:TargetPath = Join-Path $PSScriptRoot '{{target}}'
}

Describe '{{name}}' {

    It 'the target script exists' {
        Test-Path -LiteralPath $script:TargetPath | Should -BeTrue
    }

    It 'the target script parses without errors' {
        $errors = $null
        [System.Management.Automation.Language.Parser]::ParseFile(
            $script:TargetPath, [ref]$null, [ref]$errors) | Out-Null
        $errors | Should -BeNullOrEmpty
    }

