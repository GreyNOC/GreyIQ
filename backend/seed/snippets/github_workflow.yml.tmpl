# Auto-scaffolded CI workflow. Adjust the language setup and steps for your project.
name: CI

on:
  push:
    branches: [ main ]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -r requirements.txt
      # TODO: adjust to your test runner.
      - run: {{test_command}}
