{
  "name": "greyiq",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "description": "GreyIQ local-first AI chat UI with editable bots, personal preference training, an Ollama/Claude/OpenAI coding brain with out-of-the-box GPU acceleration (NVIDIA bundled, AMD auto-provisioned), and a browser CPU/WebGPU fallback.",
  "author": "GreyNOC",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "backend": "python -m backend.greyiq_api",
    "gn": "python backend/gn_cli.py",
    "desktop": "electron .",
    "freeze:backend": "pyinstaller --noconfirm --clean build/greyiq-backend.spec",
    "dist": "electron-builder --win portable nsis",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File build/build-portable.ps1",
    "check:js": "node --check server.mjs && node --check public/app.js && node --check electron/main.cjs && node --check electron/preload.cjs",
    "check:python": "python -B -c \"from pathlib import Path; p=Path('backend/greyiq_api.py'); compile(p.read_text(encoding='utf-8'), str(p), 'exec')\" && python -B -m unittest discover -s backend -t backend",
    "check:devops": "node scripts/check-devops.cjs",
    "check": "npm run check:js && npm run check:python && npm run check:devops"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.greynoc.greyiq",
    "productName": "GreyIQ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/greyiq-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "GreyIQ-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "GreyIQ-Setup-${version}.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "GreyIQ-${version}-${arch}.${ext}"
    }
  }
}
