# GreyIQ local service binding
HOST=127.0.0.1
PORT=4173
GREYIQ_HOST=127.0.0.1
GREYIQ_PORT=8766

# Runtime and desktop launch overrides
GREYIQ_RUNTIME_DIR=runtime
GREYIQ_STARTUP_TIMEOUT_MS=360000
# Optional: force a specific Python executable or virtualenv for PM2/Electron.
GREYIQ_PYTHON=
# Optional: TACNOC executable or greynoc-tacnoc project directory for the desktop launcher.
GREYIQ_TACNOC_PATH=
OLLAMA_HOST=http://127.0.0.1:11434

# Browser origin protection
# Comma-separated trusted frontend origins when serving a separate UI.
GREYIQ_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Required before exposing the backend beyond 127.0.0.1/localhost (see DEPLOY.md's
# Reverse Proxy section) -- gates EVERY request via HTTP Basic Auth. Never commit a
# real value here.
GREYIQ_ACCESS_KEY=
# Only set if you already have an equivalent auth layer in front of a non-loopback
# GREYIQ_HOST and accept the risk of running without GREYIQ_ACCESS_KEY.
GREYIQ_ALLOW_INSECURE_PUBLIC_BIND=

# BugHunter local scan guardrails
GREYIQ_CODE_SCAN_BASE_PATH=
GREYIQ_SCAN_ALLOW_PRIVATE_URLS=false
GREYIQ_WEB_ALLOWED_PORTS=80,443
GREYIQ_WEB_FETCH_TIMEOUT=8
GREYIQ_WEB_FETCH_MAX_BYTES=3000000
# Optional campaign recon expansion through crt.sh. Off by default; `gn campaign --osint`
# enables it for one local CLI run without changing this setting.
GREYIQ_RECON_OSINT=false
