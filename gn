#!/usr/bin/env bash
# GreyIQ `gn` CLI launcher (POSIX, dev/source). Runs the torch-free bug-bounty CLI.
# In a packaged build, call the frozen backend directly: greyiq-backend hunt ...
here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" "$here/backend/gn_cli.py" "$@"
  fi
done
echo "gn: Python 3 was not found on PATH. Install it, or run the packaged greyiq-backend." >&2
exit 1
