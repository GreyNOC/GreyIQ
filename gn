#!/usr/bin/env bash
# GreyIQ `gn` CLI launcher (POSIX, dev/source). Runs the torch-free bug-bounty CLI.
# In a packaged build, call the frozen backend directly: greyiq-backend hunt ...
#
# The CLI boot path is stdlib-only (see backend/test_gn_cli_stdlib_boot.py), so a
# `git clone` plus a distribution python3 is the entire dependency list — no venv,
# no pip, no .deb. That is the documented install on any Debian-family distro
# (Debian, Ubuntu, Kali, Parrot), where the release .deb may not apply at all:
# its dependencies target the current Debian stable and its arch is amd64 only.
set -u

# Resolve symlinks before locating the checkout. scripts/install-cli.sh writes a
# wrapper, but `ln -sfn .../gn ~/.local/bin/gn` is the obvious thing to do by
# hand, and `dirname` of the LINK would then look for backend/ inside ~/.local/bin.
self="${BASH_SOURCE:-$0}"
hops=0
while [ -L "$self" ] && [ "$hops" -lt 40 ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
  hops=$((hops + 1))
done
here="$(cd "$(dirname "$self")" && pwd)"
cli="$here/backend/gn_cli.py"

if [ ! -f "$cli" ]; then
  echo "gn: $cli is missing. Run this launcher from a GreyIQ checkout (git clone https://github.com/GreyNOC/GreyIQ.git), or use the packaged greyiq-cli." >&2
  exit 1
fi

# A checkout .venv wins over PATH: it is where `pip install -r requirements-cli.txt`
# puts the optional engine extras (YAML specs, cryptographic key proofs), and an
# UNACTIVATED venv is the normal state when gn is called from ~/.local/bin.
too_old=""
for py in "$here/.venv/bin/python" "$here/.venv/bin/python3" python3 python; do
  case "$py" in
    /*) [ -x "$py" ] || continue ;;
    *) command -v "$py" >/dev/null 2>&1 || continue ;;
  esac
  if "$py" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    exec "$py" "$cli" "$@"
  fi
  version="$("$py" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)"
  [ -n "$version" ] && too_old="${too_old:+$too_old, }$py ($version)"
done

if [ -n "$too_old" ]; then
  echo "gn: Python 3.11 or newer is required; found $too_old." >&2
  echo "gn: On Debian/Ubuntu/Kali/Parrot: sudo apt install python3" >&2
else
  echo "gn: Python 3 was not found on PATH." >&2
  echo "gn: On Debian/Ubuntu/Kali/Parrot: sudo apt install python3" >&2
fi
exit 1
